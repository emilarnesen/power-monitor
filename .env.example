# Copy to .env for local runs. Production values are Fly secrets. See docs/configuration.md.
TIBBER_TOKEN=replace-me
TIBBER_HOME_ID=00000000-0000-0000-0000-000000000000
ELVIA_API_KEY=replace-me
METERING_POINT_ID=707000000000000000
MAIN_FUSE_AMPS=50
GRID_VOLTAGE=230
PRICE_AREA=NO1
ENTSOE_TOKEN=replace-me
GRAFANA_INFLUX_URL=https://influx-prod-00-prod-eu-north-0.grafana.net/api/v1/push/influx/write
GRAFANA_METRICS_USER=0000000
GRAFANA_METRICS_TOKEN=replace-me
DATABASE_URL=postgresql://power_writer:replace-me@example.pooler.supabase.com:5432/postgres
